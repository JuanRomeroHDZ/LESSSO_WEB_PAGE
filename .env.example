# ============================================================
# Plantilla de Configuración: LESSSO -> Twenty CRM Sync
# Copia este archivo como .env y coloca tus valores:
#   cp .env.example .env
# ============================================================

# Token de Netlify (Personal Access Token de Netlify User Settings -> Applications)
NETLIFY_TOKEN=nfp_tu_token_aqui

# ID del Sitio en Netlify (Site details en Netlify)
NETLIFY_SITE_ID=0869e36e-3588-4fca-b5bd-963e9ee41eac

# Nombre del formulario registrado en el HTML
NETLIFY_FORM_NAME=contacto

# URL de la API de Twenty CRM (en tu contenedor Docker local)
# Ejemplo: http://localhost:3000 o http://127.0.0.1:3000
TWENTY_API_URL=http://localhost:3000

# API Key de Twenty CRM (Generada en Twenty: Settings -> Developers -> API Keys)
TWENTY_API_KEY=tu_token_de_twenty_aqui
